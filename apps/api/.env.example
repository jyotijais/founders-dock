# ==========================================
#  FoundersDock API — environment variables
#  Copy to `.env` and fill in real values.
#  NEVER commit the real `.env`.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# --- Database (PostgreSQL) ---------------------------------
# Local:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/foundersdock_db"
#
# Production (RDS) — set via AWS Secrets Manager, not a file:
# DATABASE_URL="postgresql://USER:PASS@foundersdock-db.XXXX.us-east-1.rds.amazonaws.com:5432/foundersdock?sslmode=require"

# --- Firebase Admin ---------------------------------------
# Preferred for production. Paste the ENTIRE contents of your
# service account JSON on ONE line, with newlines escaped as \n
#
# AWS Secrets Manager (JSON key) -> Environment variable:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# For local dev you can leave this unset and the app will fall
# back to reading ./serviceAccountKey.json from disk.
FIREBASE_SERVICE_ACCOUNT=

# --- CORS -------------------------------------------------
# Comma-separated list of allowed browser origins.
# Leave empty/unset in development to allow all origins.
CORS_ORIGINS=

# ==========================================
#  FoundersDock Web — environment variables
#  Copy to `.env` and fill in real values.
#
#  ⚠️  IMPORTANT — READ THIS
#  Vite INLINES every VITE_* variable into the JavaScript bundle
#  AT BUILD TIME. Anything here is publicly visible to anyone who
#  opens DevTools. That is fine for the Firebase *web* config
#  below (it is public by design and secured by Firebase Security
#  Rules), but NEVER put a secret here.
#
#  Because these are baked in at build time, your CI pipeline must
#  supply them as Docker build args when building the image.
# ==========================================

# --- Firebase Web SDK (public config — safe to expose) ----
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend API base URL ---------------------------------
# Local development:
VITE_API_URL=http://localhost:5000

# Production (set in CI, not committed):
# VITE_API_URL=https://api.foundersdock.com
